nextflow.enable.dsl = 2

params {
    sample_id = null
    r1        = null
    r2        = null
    reference = null
    outdir    = null
    min_depth = 10
    min_qual  = 30
}

process {
    container = 'bactgen-tools:1.0'
    cpus      = 2
    memory    = 4.GB
    errorStrategy = 'terminate'
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
