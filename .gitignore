# Python cache and virtual environment
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local credentials and environment variables
.env

# Nextflow temporal files and cache
work/
.nextflow/
.nextflow.log*
trace-*.txt*
report-*.html*
timeline-*.html*

# Logs and pipeline run outputs
*.log
data/runs/*
!data/runs/.gitkeep

# Heavy sequencing and alignment files (keep folder structure via .gitkeep)
data/fastq/*
!data/fastq/.gitkeep
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai

# Reference genome alignment indexes (keep .fasta / .fa / .fna tracked)
*.fai
*.mmi
*.amb
*.ann
*.bwt
*.pac
*.sa
*.dict
*.bt2
